# 强制 React Native 从源码编译（关闭 0.84 的 prebuilt 核心 / 预编译依赖）。
# 原因：use_frameworks! :dynamic + New Arch 下，预编译的 React-Core-prebuilt 与
# 源码编译的 ReactCodegen 符号对不上，新增任何 pod 都会触发 ReactCodegen 链接器
# 报错（getDebug*/Sealable/vtable 等 undefined symbol）。从源码编译即可消除该不一致。
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
ENV['RCT_USE_RN_DEP'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Workaround for react-native-reanimated v4 needing RNWorklets
source 'https://cdn.cocoapods.org/'

def patch_hermes_cli_path(installer)
  # PODS_ROOT points to RingMemoryApp/ios/Pods, so node_modules is two levels up.
  hermes_cli_path = '${PODS_ROOT}/../../node_modules/hermes-compiler/hermesc/osx-bin/hermesc'
  support_dir = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-RingMemoryApp')

  %w[Pods-RingMemoryApp.debug.xcconfig Pods-RingMemoryApp.release.xcconfig].each do |filename|
    path = File.join(support_dir, filename)
    next unless File.exist?(path)

    content = File.read(path)
    next if content.include?("HERMES_CLI_PATH = #{hermes_cli_path}")

    content = if content.match?(/^HERMES_CLI_PATH = .*$/)
      content.gsub(/^HERMES_CLI_PATH = .*$/, "HERMES_CLI_PATH = #{hermes_cli_path}")
    else
      "#{content}\nHERMES_CLI_PATH = #{hermes_cli_path}\n"
    end

    File.write(path, content)
  end
end

platform :ios, '16.0'
prepare_react_native_project!

use_frameworks! :linkage => :dynamic

target 'RingMemoryApp' do
  config = use_native_modules!

  # Explicitly add RNWorklets for reanimated v4
  pod 'RNWorklets', :path => '../node_modules/react-native-worklets'

  # MR20「记忆粒」原生 BLE 模块（独立 LocalPod，纯 CoreBluetooth，与 ring 无关）
  pod 'RTNMr20Module', :path => './LocalPods/RTNMr20Module'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Rokid CXR-L SDK integration.
  # The Rokid SDK (RGCxrClient/RGCoreKit) ships device-only framework slices and
  # cannot build for the iOS Simulator. Set RN_SIMULATOR=1 before `pod install`
  # to exclude it for simulator builds; the JS layer (src/native/RokidModule.ts)
  # already falls back to a no-op when the native module is absent. Device builds
  # (the default, no env var) keep the full Rokid integration unchanged.
  unless ENV['RN_SIMULATOR'] == '1'
    pod 'RTNRokidModule', :path => './LocalPods/RTNRokidModule'
    pod 'RGCxrClient'
    pod 'RGCoreKit'
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end

post_integrate do |installer|
  patch_hermes_cli_path(installer)
end
